<Project Sdk="Microsoft.NET.Sdk">

  <!--
    这个 csproj 只是给装了 VS / MSBuild / .NET SDK 的人用的。
    本机没有 SDK，日常构建走 build.bat（直接调系统自带的 csc.exe）。
    两条路径编译的是同一批 src\*.cs，不要在这里加任何源文件特有的开关。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ScreenWatermark</RootNamespace>
    <AssemblyName>ScreenWatermark</AssemblyName>
    <LangVersion>5</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>res\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 保持和老 csc 一致的宽松告警策略，避免两条构建路径结论不一致 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
